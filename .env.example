# Frontend
VITE_BASE_URL=/all-stats
VITE_JIRA_API_URL=http://localhost:5001/api
VITE_GITLAB_API_URL=http://localhost:5003/api
VITE_GIT_ANALYZER_API_URL=http://localhost:5002/api
VITE_USERS_STATE_API_URL=http://localhost:5005/api
VITE_CONFLUENCE_API_URL=http://localhost:5006/api
VITE_JOB_SERVER_API_URL=http://localhost:5004/api
VITE_HANGFIRE_DASHBOARD_URL=http://localhost:5004/hangfire
VITE_CALENDAR_API_URL=http://localhost:5010
# Set to true when the custom Presence service is unavailable.
VITE_DISABLE_PRESENCE=false
# Set to true when Jira/GitLab credentials are not configured.
VITE_DISABLE_JIRA_USERS=false
VITE_DISABLE_GITLAB_USERS=false
VITE_GITLAB_URL=https://gitlab.example.com/api/v4
VITE_JIRA_BROWSE_URL=https://jira.example.com/browse/
VITE_CONFLUENCE_BROWSE_URL=https://confluence.example.com

# Optional. Leave empty unless the browser must call GitLab directly.
VITE_GIT_TOKEN=
